# R40-4: force `npm install <pkg>` to write an EXACT version to
# package.json rather than a `^1.2.3` range. Supply-chain attacks
# (e.g., the `@babel/traverse` / `ua-parser-js` class of malicious
# package update) depend on loose ranges auto-upgrading transitive
# deps. `save-exact=true` keeps our direct deps pinned; a Renovate /
# Dependabot PR is the only path for a version bump, giving a code-
# review window before anything lands.
save-exact=true

# Prefer `engine-strict` so a mismatched Node major blocks install.
# Avoids subtle incompatibility bugs (e.g. an upgrade that now requires
# node 22 but wrangler is still on node 20 on the GH runner).
engine-strict=true

# `npm audit signatures` should also run in CI for defense-in-depth
# against a registry compromise flipping a package to an unsigned
# build. That's added to the deploy workflow (not here — this flag
# isn't a legit .npmrc key).

# R43-LOW: considered `ignore-scripts=true` to block preinstall /
# postinstall lifecycle scripts from arbitrary deps — the R43 audit
# flagged supply-chain compromise via a malicious install hook
# exfiltrating the runner's CLOUDFLARE_API_TOKEN / DATABASE_URL /
# RESEND_API_KEY / Telegram bot secret. Declined in-band because
# Next.js's build chain (esbuild native binary download, sharp's
# image-lib postinstall, @opennextjs/cloudflare codegen) legitimately
# requires lifecycle scripts — enabling the flag breaks the build.
# The R42-H fork-PR gate + `permissions: contents: read` already
# closes the main attack surface (a fork PR can't edit package.json
# and reach the install step). A future hardening migration to
# explicit postinstall steps under a trusted-deps allowlist is
# tracked; for now, `npm audit signatures` in guardrails.yml gates
# a registry-compromise flip.
