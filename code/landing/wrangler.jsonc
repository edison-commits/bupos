{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "basicuniform-landing",
  "main": "worker.js",
  "compatibility_date": "2024-12-30",

  // Custom domain routing — store public site
  "routes": [
    { "pattern": "basicuniform.com", "custom_domain": true },
    { "pattern": "www.basicuniform.com", "custom_domain": true }
  ]
}
