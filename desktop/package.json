{
  "name": "bupos-desktop",
  "productName": "BasicUniformPOS",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop shell for BasicUniformPOS — wraps basicuniformpos.com with kiosk mode, auto-launch, tray controls, second-monitor customer display, and remembered receipt-printer (Web Serial) selection. The web content auto-updates on every deploy; this shell only changes when shell features change.",
  "main": "main.js",
  "author": "Basic Uniform",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.basicuniform.pos",
    "productName": "BasicUniformPOS",
    "files": [
      "main.js",
      "offline.html"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BasicUniformPOS"
    }
  }
}
